# Copy this to .env and fill in values
# Generate a secret key with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# One-time token required to create the initial administrator.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty (setup stays locked) rather than reusing a published placeholder.
BOOTSTRAP_TOKEN=

# Set both to false only for loopback-only development without a TLS proxy.
ENFORCE_HTTPS=true
TRUST_PROXY_HEADERS=true

# On Linux, match the owner of ./data so the non-root container can write it.
APP_UID=1000
APP_GID=1000

# Get this token from Cloudflare Zero Trust → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
